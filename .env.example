# Telegram
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# Database — SQLite by default; set a postgres URL for production
# DATABASE_URL=sqlite+aiosqlite:///./bot.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/telegram_notion
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# Usage limits (per user)
DAILY_REQUEST_LIMIT=100
MONTHLY_REQUEST_LIMIT=2000

# Throttling
THROTTLE_RATE_SECONDS=2.0

# Max Telegram media size before download (bytes)
MAX_FILE_SIZE_BYTES=20971520

# Default locale fallback (ru|en)
DEFAULT_LOCALE=en
